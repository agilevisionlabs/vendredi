{
  "vendredi_case": 1,
  "id": "reject-orders",
  "name": "Reject every order",
  "description": "Answers each ORDERS with a negative CONTRL and sends no business reply.",
  "standard": "edifact",
  "tags": [
    "orders",
    "fault",
    "reject"
  ],
  "acknowledge": "always",
  "rules": [
    {
      "name": "Orders",
