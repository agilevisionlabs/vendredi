{
  "vendredi_case": 1,
  "id": "send-invoice",
  "name": "Send an invoice",
  "description": "Confirms orders and sends an INVOIC on request. Run `initiate <partner> Invoice` to send it.",
  "standard": "edifact",
  "tags": [
    "orders",
    "invoice",
    "partner-initiated"
  ],
  "acknowledge": "always",
  "rules": [
    {
      "name": "Orders",
      "message": "ORDERS",
      "version": "D96A",
      "actions": [
        {
          "document": "ordrsp.edi"
        }
      ]
    }
  ],
  "samples": [
    {
      "name": "Order",
      "document": "order.edi"
    }
  ],
  "initiate": [
    {
      "name": "Invoice",
      "actions": [
        {
          "document": "invoic.edi"
        }
      ]
    }
  ],
  "expect": [
    {
      "sample": "Order",
      "replies": [
        "ack.edi",
        "ordrsp.edi"
      ]
    },
    {
      "initiate": "Invoice",
      "replies": [
        "invoic.edi"
      ]
    }
  ],
  "files": {
    "order.edi": "UNH+1+ORDERS:D:96A:UN'BGM+220+PO1001+9'DTM+137:20261125:102'NAD+BY+5412345000013::9'LIN+1++4000862141404:SRS'QTY+21:48'UNT+7+1'",
    "ordrsp.edi": "UNH+1+ORDRSP:D:96A:UN'BGM+231+PO1001+29'UNT+3+1'",
    "ack.edi": "UNH+1+CONTRL:D:96A:UN'UCI+S1+BUYER:ZZ+PARTNER:ZZ+7'UNT+3+1'",
    "invoic.edi": "UNH+1+INVOIC:D:96A:UN'BGM+380+INV2001+9'DTM+137:20261125:102'MOA+77:1250.00'UNT+5+1'"
  }
}
